[{"question_no":1,"question":"Growth in higher plants is generally","options":{"A":"Limited","B":"Indeterminate and open","C":"Closed","D":"Determinate"},"answer":"B"},{"question_no":2,"question":"The phase of growth in which cells show maximum enlargement and vacuolation is the","options":{"A":"Elongation phase","B":"Maturation phase","C":"Lag phase","D":"Meristematic phase"},"answer":"A"},{"question_no":3,"question":"Increase in growth per unit time is called","options":{"A":"Growth rate","B":"Growth curve","C":"Plasticity","D":"Growth pattern"},"answer":"A"},{"question_no":4,"question":"The sigmoid growth curve has the phases in the order","options":{"A":"Stationary, lag and log","B":"Lag, log and stationary","C":"Log, lag and stationary","D":"Lag, stationary and log"},"answer":"B"},{"question_no":5,"question":"Loss of the capacity to divide in permanent tissues and later regaining it is called","options":{"A":"Senescence","B":"Differentiation","C":"Dedifferentiation","D":"Redifferentiation"},"answer":"C"},{"question_no":6,"question":"Heterophylly is observed in","options":{"A":"Maize and wheat","B":"Pea and bean","C":"Cotton, coriander and larkspur","D":"Rose and mango"},"answer":"C"},{"question_no":7,"question":"Auxin was isolated from the tips of oat coleoptiles by","options":{"A":"Skoog and Miller","B":"Laibach","C":"F. W. Went","D":"Kurosawa"},"answer":"C"},{"question_no":8,"question":"Which of the following is a synthetic auxin used as a weedicide?","options":{"A":"IBA","B":"IAA","C":"2,4-D","D":"GA3"},"answer":"C"},{"question_no":9,"question":"Apical dominance is caused by","options":{"A":"Auxins","B":"Cytokinins","C":"Ethylene","D":"Gibberellins"},"answer":"A"},{"question_no":10,"question":"Bolting, the sudden elongation of internodes in rosette plants like cabbage, is induced by","options":{"A":"Auxins","B":"Ethylene","C":"Abscisic acid","D":"Gibberellins"},"answer":"D"},{"question_no":11,"question":"Gibberellins were discovered from the fungus","options":{"A":"Aspergillus","B":"Rhizopus","C":"Penicillium","D":"Gibberella fujikuroi"},"answer":"D"},{"question_no":12,"question":"Gibberellins are used to","options":{"A":"Induce dormancy","B":"Prevent fruit ripening","C":"Close stomata","D":"Increase the length of grape stalks and sugarcane stems"},"answer":"D"},{"question_no":13,"question":"Which hormone promotes cell division?","options":{"A":"Abscisic acid","B":"Ethylene","C":"Auxin","D":"Cytokinin"},"answer":"D"},{"question_no":14,"question":"Kinetin was discovered by","options":{"A":"Skoog and Miller","B":"Went","C":"Kurosawa","D":"Laibach"},"answer":"A"},{"question_no":15,"question":"Natural cytokinin zeatin was first isolated from","options":{"A":"Tomato","B":"Coconut milk","C":"Maize kernels","D":"Oat"},"answer":"C"},{"question_no":16,"question":"Which hormone is a gaseous plant growth regulator?","options":{"A":"Auxin","B":"Ethylene","C":"Cytokinin","D":"Gibberellin"},"answer":"B"},{"question_no":17,"question":"Ethylene promotes","options":{"A":"Cell division","B":"Fruit ripening","C":"Stomatal opening","D":"Apical dominance"},"answer":"B"},{"question_no":18,"question":"Ethephon releases","options":{"A":"Ethylene","B":"Zeatin","C":"ABA","D":"Auxin"},"answer":"A"},{"question_no":19,"question":"Which plant hormone is called the stress hormone?","options":{"A":"Cytokinin","B":"Auxin","C":"Gibberellin","D":"Abscisic acid"},"answer":"D"},{"question_no":20,"question":"Abscisic acid is involved in","options":{"A":"Cell enlargement","B":"Cell division","C":"Stomatal closure and seed dormancy","D":"Fruit ripening only"},"answer":"C"},{"question_no":21,"question":"Flowering in a plant is controlled by the duration of light and dark periods. This phenomenon is","options":{"A":"Vernalisation","B":"Phototropism","C":"Photoperiodism","D":"Thigmotropism"},"answer":"C"},{"question_no":22,"question":"Plants that flower when the light period is shorter than the critical period are","options":{"A":"Day neutral plants","B":"Short day plants","C":"Night neutral plants","D":"Long day plants"},"answer":"B"},{"question_no":23,"question":"Vernalisation refers to","options":{"A":"Seed dormancy","B":"Promotion of flowering by exposure to low temperature","C":"Fruit ripening","D":"Photoperiodic flowering"},"answer":"B"},{"question_no":24,"question":"The perceived light stimulus for photoperiodism is received by the","options":{"A":"Roots","B":"Stem tip","C":"Leaves","D":"Flowers"},"answer":"C"},{"question_no":25,"question":"Seed dormancy is overcome by","options":{"A":"Scarification and gibberellic acid","B":"Ethylene gas only","C":"ABA","D":"Excess water"},"answer":"A"}]