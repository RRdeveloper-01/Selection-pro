[{"question_no":1,"question":"The master endocrine gland of the body is the","options":{"A":"Adrenal","B":"Pituitary","C":"Pancreas","D":"Thyroid"},"answer":"B"},{"question_no":2,"question":"Hormones released from the posterior pituitary are","options":{"A":"FSH and LH","B":"Growth hormone and prolactin","C":"Oxytocin and vasopressin","D":"TSH and ACTH"},"answer":"C"},{"question_no":3,"question":"Oxytocin acts on the","options":{"A":"Smooth muscles of the uterus and mammary glands","B":"Liver","C":"Thyroid","D":"Kidney tubules"},"answer":"A"},{"question_no":4,"question":"Excess secretion of growth hormone in adults causes","options":{"A":"Cretinism","B":"Gigantism","C":"Acromegaly","D":"Dwarfism"},"answer":"C"},{"question_no":5,"question":"Deficiency of growth hormone in childhood leads to","options":{"A":"Gigantism","B":"Cretinism","C":"Acromegaly","D":"Pituitary dwarfism"},"answer":"D"},{"question_no":6,"question":"Prolactin regulates","options":{"A":"Blood glucose","B":"Water balance","C":"Growth of mammary glands and milk formation","D":"Calcium level"},"answer":"C"},{"question_no":7,"question":"Melanocyte stimulating hormone acts on","options":{"A":"Thyroid","B":"Kidney","C":"Pancreas","D":"Melanocytes regulating skin pigmentation"},"answer":"D"},{"question_no":8,"question":"Which hormone stimulates the adrenal cortex?","options":{"A":"TSH","B":"ACTH","C":"FSH","D":"LH"},"answer":"B"},{"question_no":9,"question":"Hormones released by the thyroid gland include","options":{"A":"Insulin and glucagon","B":"Tetraiodothyronine and triiodothyronine","C":"Melatonin only","D":"Cortisol and aldosterone"},"answer":"B"},{"question_no":10,"question":"Simple goitre is caused by","options":{"A":"Excess iodine","B":"Excess calcium","C":"Iodine deficiency","D":"Vitamin D deficiency"},"answer":"C"},{"question_no":11,"question":"Hypothyroidism during pregnancy causes defective development in the baby called","options":{"A":"Graves' disease","B":"Acromegaly","C":"Goitre","D":"Cretinism"},"answer":"D"},{"question_no":12,"question":"Exophthalmic goitre is a condition of","options":{"A":"Hypoparathyroidism","B":"Hypoglycaemia","C":"Hyperthyroidism","D":"Hypothyroidism"},"answer":"C"},{"question_no":13,"question":"Parathyroid hormone increases","options":{"A":"Blood sodium only","B":"Blood glucose","C":"Blood calcium level","D":"Blood potassium only"},"answer":"C"},{"question_no":14,"question":"Which hormone lowers blood calcium level?","options":{"A":"Parathyroid hormone","B":"Cortisol","C":"Thymosin","D":"Thyrocalcitonin"},"answer":"D"},{"question_no":15,"question":"The thymus secretes","options":{"A":"Thymosins","B":"Insulin","C":"Melatonin","D":"Thyroxine"},"answer":"A"},{"question_no":16,"question":"The adrenal medulla secretes","options":{"A":"Adrenaline and noradrenaline","B":"Testosterone","C":"Aldosterone","D":"Cortisol"},"answer":"A"},{"question_no":17,"question":"Adrenaline and noradrenaline are called emergency hormones because they","options":{"A":"Control calcium","B":"Induce sleep","C":"Digest food","D":"Prepare the body for fight or flight"},"answer":"D"},{"question_no":18,"question":"The hormone that regulates water and electrolyte balance in the adrenal cortex is","options":{"A":"Insulin","B":"Adrenaline","C":"Cortisol","D":"Aldosterone"},"answer":"D"},{"question_no":19,"question":"Cortisol is a","options":{"A":"Catecholamine","B":"Mineralocorticoid","C":"Gonadotropin","D":"Glucocorticoid"},"answer":"D"},{"question_no":20,"question":"Addison's disease is due to","options":{"A":"Deficiency of thyroxine","B":"Excess aldosterone","C":"Excess cortisol","D":"Deficiency of adrenal cortex hormones"},"answer":"D"},{"question_no":21,"question":"The hormone secreted by alpha cells of the islets of Langerhans is","options":{"A":"Gastrin","B":"Somatostatin","C":"Insulin","D":"Glucagon"},"answer":"D"},{"question_no":22,"question":"Insulin secreted by beta cells","options":{"A":"Breaks down glycogen","B":"Lowers blood glucose by promoting gl