[{"question_no":1,"question":"The plasma protein involved in blood coagulation is","options":{"A":"Globulin","B":"Fibrinogen","C":"Albumin","D":"Haemoglobin"},"answer":"B"},{"question_no":2,"question":"The plasma protein mainly responsible for osmotic balance is","options":{"A":"Prothrombin","B":"Globulin","C":"Albumin","D":"Fibrinogen"},"answer":"C"},{"question_no":3,"question":"The most abundant WBCs in human blood are","options":{"A":"Neutrophils","B":"Lymphocytes","C":"Basophils","D":"Eosinophils"},"answer":"A"},{"question_no":4,"question":"The least abundant white blood cells are","options":{"A":"Lymphocytes","B":"Eosinophils","C":"Basophils","D":"Monocytes"},"answer":"C"},{"question_no":5,"question":"Cells that secrete histamine and heparin are","options":{"A":"Monocytes","B":"Eosinophils","C":"Basophils","D":"Neutrophils"},"answer":"C"},{"question_no":6,"question":"Which cells are involved in allergic reactions and resist infections?","options":{"A":"Eosinophils","B":"Lymphocytes","C":"Neutrophils","D":"Platelets"},"answer":"A"},{"question_no":7,"question":"The normal number of RBCs in an adult human is about","options":{"A":"5000 to 6000 per cubic mm","B":"50 to 55 thousand per cubic mm","C":"5 to 5.5 million per cubic mm","D":"1.5 to 3.5 lakh per cubic mm"},"answer":"C"},{"question_no":8,"question":"The life span of human RBCs is about","options":{"A":"10 days","B":"30 days","C":"120 days","D":"365 days"},"answer":"C"},{"question_no":9,"question":"Platelets are also known as","options":{"A":"Erythrocytes","B":"Leucocytes","C":"Monocytes","D":"Thrombocytes"},"answer":"D"},{"question_no":10,"question":"Universal blood donor group is","options":{"A":"B negative","B":"A positive","C":"O negative","D":"AB positive"},"answer":"C"},{"question_no":11,"question":"Persons with blood group AB are","options":{"A":"Having no antigens","B":"Universal recipients","C":"Having both anti-A and anti-B","D":"Universal donors"},"answer":"B"},{"question_no":12,"question":"Erythroblastosis foetalis occurs when","options":{"A":"Both are Rh positive","B":"Both are Rh negative","C":"An Rh negative mother carries an Rh positive foetus","D":"An Rh positive mother carries an Rh negative foetus"},"answer":"C"},{"question_no":13,"question":"Thrombokinase converts","options":{"A":"Fibrinogen into fibrin","B":"Prothrombin into thrombin","C":"Thrombin into prothrombin","D":"Fibrin into fibrinogen"},"answer":"B"},{"question_no":14,"question":"Which ion is essential for blood clotting?","options":{"A":"Magnesium","B":"Sodium","C":"Calcium","D":"Potassium"},"answer":"C"},{"question_no":15,"question":"The pacemaker of the heart is the","options":{"A":"Bundle of His","B":"Atrio-ventricular node","C":"Purkinje fibres","D":"Sino-atrial node"},"answer":"D"},{"question_no":16,"question":"The valve between the left atrium and the left ventricle is the","options":{"A":"Pulmonary valve","B":"Semilunar valve","C":"Tricuspid valve","D":"Bicuspid valve"},"answer":"D"},{"question_no":17,"question":"In an ECG, the P wave represents","options":{"A":"Repolarisation of the atria","B":"Depolarisation of the ventricles","C":"Depolarisation of the atria","D":"Repolarisation of the ventricles"},"answer":"C"},{"question_no":18,"question":"The QRS complex in an ECG represents","options":{"A":"Atrial depolarisation","B":"Ventricular depolarisation","C":"Atrial repolarisation","D":"Ventricular repolarisation"},"answer":"B"},{"question_no":19,"question":"The T wave in an ECG indicates","options":{"A":"Atrial contraction","B":"Return of ventricles from excited to normal state","C":"Ventricular depolarisation","D":"Closure of valves"},"answer":"B"},{"question_no":20,"question":"The first heart sound (lub) is associated with the closure of","options":{"A":"Semilunar valves","B":"Pulmonary valve only","C":"Tricuspid and bicuspid valves","D":"Aortic valve only"},"answer":"C"},{"question_no":21,"question":"The duration of the cardiac cycle in a normal person is about","options":{"A":"0.12 seconds","B":"0.8 seconds","C":"1.5 seconds","D":"0.4 seconds"},"answer":"B"},{"question_no":22,"question":"Cardiac output equals","options":{"A":"Heart rate / stroke volume","B":"Stroke volume + heart rate","C":"Blood pressure × heart rate","D":"Stroke volume × heart rate"},"answer":"D"},{"question_no":23,"question":"The normal blood pressure of a healthy adult is about","options":{"A":"100/160 mm Hg","B":"140/90 mm Hg","C":"80/120 mm Hg","D":"120/80 mm Hg"},"answer":"D"},{"question_no":24,"question":"Deposits of calcium, fat and cholesterol in coronary arteries cause","options":{"A":"Arrhythmia","B":"Atherosclerosis","C":"Angina","D":"Heart failure"},"answer":"B"},{"question_no":25,"question":"The vein that carries oxygenated blood is the","options":{"A":"Pulmonary vein","B":"Pulmonary artery","C":"Vena cava","D":"Hepatic portal vein"},"answer":"A"}]